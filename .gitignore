# Build output. dist/audio and dist/images/pluginassets are source art that
# happens to live here rather than being generated, so they stay tracked — see
# the note at the bottom before untracking anything under dist.
dist/

# Vitest suites (run from the checkout, not shipped).
src/__tests__/

# Runtime user-uploaded content (emojis, hats, avatars, pasted images). Lives
# outside dist/ so a build/`dist` wipe can't delete it; the server recreates the
# folder structure on boot, so nothing here needs committing.
user-content/

# Standalone dev install (see package.json / vite.config.js). The parent
# eyechat-server checkout has its own node_modules; this one only exists when
# someone is working on the client on its own.
node_modules/

# Stylesheets are authored in public/ and copied into dist/ by the Vite build
# (public dir) — edits go in public/, never in dist/. Covered by `dist/` above;
# kept as a note because the copies look editable and are not.
#   dist/theme.css, dist/chat-messages.css, dist/search.css
#
# Note: `dist/` only stops *new* files being added, so the build output that was
# already committed had to be dropped from the index by hand. That's been done —
# index.html, search.html and assets/* are regenerated by every build, and
# out.css / test.js (+ their maps) were dead weight from the old esbuild
# pipeline, referenced by nothing. A deploy is expected to run `npm run build`.
#
# Still tracked under dist/ on purpose: dist/audio/* and
# dist/images/pluginassets/* are source art rather than build output. Nothing
# regenerates them, so a fresh deploy needs them committed.
